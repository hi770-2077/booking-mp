{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "installCommand": "npm install --include=dev",
  "crons": [
    {
      "path": "/api/scheduler",
      "schedule": "0 2 * * *"
    }
  ]
}